# Copy to .env and fill in. Never commit .env.

# PostgreSQL (docker compose)
POSTGRES_USER=omborchi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=omborchi

# API
# DATABASE_URL is composed automatically in docker-compose; set it yourself when running `npm run dev:api`.
DATABASE_URL=postgres://omborchi:change-me@localhost:5432/omborchi
PORT=3000
APP_PORT=8080
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
TRUST_PROXY=false
ALLOW_REGISTRATION=true
MIGRATE_ON_START=true
# Password given to the demo users created by `npm run seed`
DEMO_PASSWORD=change-me-too
